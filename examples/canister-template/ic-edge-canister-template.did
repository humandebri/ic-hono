type Header = record { text; text };

type HttpRequest = record {
  method : text;
  url : text;
  headers : vec Header;
  body : blob;
  certificate_version : opt nat16;
};

type HttpResponse = record {
  status_code : nat16;
  headers : vec Header;
  body : blob;
  upgrade : opt bool;
};

type TransformArgs = record {
  context : blob;
  response : HttpOutcallResponse;
};

type HttpOutcallHeader = record {
  name : text;
  value : text;
};

type HttpOutcallResponse = record {
  status : nat;
  headers : vec HttpOutcallHeader;
  body : blob;
};

type RuntimeInfo = record {
  backend : text;
  generation : nat64;
  bytecode_sha256 : opt text;
};

type RuntimeSnapshotInfo = record {
  generation : nat64;
  bytecode_bytes : nat64;
  manifest_bytes : nat64;
  env_names : vec text;
};

service : {
  http_request : (HttpRequest) -> (HttpResponse) query;
  http_request_update : (HttpRequest) -> (HttpResponse);
  upload_bytecode : (text, blob) -> (variant { Ok; Err : text });
  begin_bytecode_upload : (text, nat64, text) -> (variant { Ok; Err : text });
  append_bytecode_chunk : (text, nat64, blob) -> (variant { Ok; Err : text });
  commit_bytecode_upload : (text) -> (variant { Ok; Err : text });
  abort_bytecode_upload : (text) -> (variant { Ok; Err : text });
  set_env : (text, text) -> (variant { Ok; Err : text });
  env_names : () -> (vec text) query;
  bytecode_size : (text) -> (opt nat64) query;
  runtime_info : () -> (RuntimeInfo) query;
  runtime_history : () -> (vec RuntimeSnapshotInfo) query;
  rollback_runtime : (nat64) -> (variant { Ok; Err : text });
  fetch_outcall : (text) -> (HttpResponse);
  fetch_outcall_replicated : (text) -> (HttpResponse);
  transform_strip_headers : (TransformArgs) -> (HttpOutcallResponse) query;
}
